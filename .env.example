# Client-visible feature switches
NEXT_PUBLIC_NEON_AUTH_ENABLED=false
NEXT_PUBLIC_READFLOW_REMOTE_STORAGE_ENABLED=false

# ThinkZone Neon Auth (AI-Course-Generator, aws-us-east-2)
NEON_AUTH_BASE_URL=https://ep-mute-surf-a5z091zf.neonauth.us-east-2.aws.neon.tech/AI-Course-Generator/auth
NEON_AUTH_COOKIE_SECRET=replace-with-at-least-32-random-characters

# Use a restricted runtime Postgres role, not a project owner/superuser URL.
DATABASE_URL=postgresql://readflow_app:replace-me@your-neon-host/AI-Course-Generator?sslmode=require

# Private Neon Object Storage bucket in ThinkZone's main branch.
READFLOW_STORAGE_ENDPOINT=https://br-autumn-pine-a56nxd5y.storage.c-1.us-east-2.aws.neon.tech
READFLOW_STORAGE_REGION=us-east-2
READFLOW_STORAGE_ACCESS_KEY_ID=replace-with-scoped-storage-credential
READFLOW_STORAGE_SECRET_ACCESS_KEY=replace-with-scoped-storage-secret
READFLOW_STORAGE_BUCKET=readflow-books
