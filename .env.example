# Client-visible feature switches
NEXT_PUBLIC_BETTER_AUTH_ENABLED=false
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_READFLOW_REMOTE_STORAGE_ENABLED=false

# Self-hosted Better Auth on the readflow Postgres database.
# Use a restricted runtime role for this schema; run db/migrations/0002_better_auth.sql as an owner.
BETTER_AUTH_DATABASE_URL=postgresql://readflow_auth_app:replace-me@your-neon-host/readflow?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Use a restricted runtime Postgres role, not a project owner/superuser URL.
DATABASE_URL=postgresql://readflow_app:replace-me@your-neon-host/readflow?sslmode=require

# Private Neon Object Storage bucket in ThinkZone's main branch.
READFLOW_STORAGE_ENDPOINT=https://br-autumn-pine-a56nxd5y.storage.c-1.us-east-2.aws.neon.tech
READFLOW_STORAGE_REGION=us-east-2
READFLOW_STORAGE_ACCESS_KEY_ID=replace-with-scoped-storage-credential
READFLOW_STORAGE_SECRET_ACCESS_KEY=replace-with-scoped-storage-secret
READFLOW_STORAGE_BUCKET=readflow-books
